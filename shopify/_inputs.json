body><tr><th>4ft</th><td>Small double</td></tr><tr><th>King</th><td>152 × 200cm</td></tr></tbody></table><h3>Care</h3><ul><li>Easy to remove and machine wash.</li><li>Follow the care label for wash temperature and drying.</li></ul>","vendor":"Elovela","productType":"Guard Protectors","tags":["guard-protectors"],"status":"ACTIVE","productOptions":[{"name":"Size","position":1,"values":[{"name":"Single"},{"name":"4ft"},{"name":"Double"},{"name":"King"},{"name":"Super King"}]}],"variants":[{"optionValues":[{"optionName":"Size","name":"Single"}],"price":"11.64","position":1,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true}},{"optionValues":[{"optionName":"Size","name":"4ft"}],"price":"12.64","position":2,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true}},{"optionValues":[{"optionName":"Size","name":"Double"}],"price":"13.64","position":3,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true}},{"optionValues":[{"optionName":"Size","name":"King"}],"price":"14.64","position":4,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true}},{"optionValues":[{"optionName":"Size","name":"Super King"}],"price":"15.64","position":5,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true}}],"files":[{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/protector-corner.jpg?t=312f41645e32ba470dbb3333235982bf6d2589d50d2be4384afb2a6cd76164e6.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078848.fp&direct=1","alt":"Fitting the Guard protector over a mattress corner","contentType":"IMAGE"},{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/protector-bed.jpg?t=aec3da564984a25f957bb614565dc4433874b00ba165b0d713f3783ef63a31a9.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078848.fp&direct=1","alt":"Guard protector on a made bed","contentType":"IMAGE"},{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/protector-droplets.jpg?t=1ef0368e22035ba38250a0eed1acc45405f4b9ccded9fb556b7f41abf3654ecd.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078849.fp&direct=1","alt":"Water beading on the waterproof surface","contentType":"IMAGE"},{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/protector-spill.jpg?t=839c4fdeacfaf148572e22a7d255ebb1f685220cb71c9c021cddf239e29d5784.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078849.fp&direct=1","alt":"A spill sitting on top of the protector","contentType":"IMAGE"}],"metafields":[{"namespace":"custom","key":"spec_line","type":"single_line_text_field","value":"100% waterproof · 30cm deep skirt · Single to Super King"},{"namespace":"custom","key":"badges","type":"single_line_text_field","value":"Hypoallergenic"}]},{"title":"Terry Towel Waterproof Mattress Protector","handle":"terry-waterproof-protector","descriptionHtml":"<p>A soft terry towel surface over a waterproof layer. It absorbs spills and lets air circulate, so your bed stays fresh and you stay comfortable.</p><ul><li>100% waterproof</li><li>Breathable terry towel surface</li><li>Aloe vera treated</li><li>Deep fitted stretch skirt</li><li>Machine washable</li></ul><h3>Description</h3><p>Helps protect your mattress against allergens, dust and bed bugs, while adding an extra comfortable layer to your bed.</p><p>The terry towel surface absorbs liquid and moisture and allows air to circulate, so you sleep comfortably and your mattress stays clean.</p><h3>Specifications</h3><table><tbody><tr><th>Waterproof</th><td>100%</td></tr><tr><th>Surface</th><td>Terry towel</td></tr><tr><th>Treatment</th><td>Aloe vera</td></tr><tr><th>Skirt</th><td>Deep fitted stretch skirt</td></tr><tr><th>Colour</th><td>White</td></tr></tbody></table><h3>Size guide</h3><table><tbody><tr><th>Single</th><td>90 × 190cm</td></tr><tr><th>4ft</th><td>Small double</td></tr></tbody></table><h3>Care</h3><ul><li>Machine washable.</li><li>Follow the care label for wash temperature and drying.</li></ul>","vendor":"Elovela","productType":"Guard Protectors","tags":["guard-protectors"],"status":"ACTIVE","productOptions":[{"name":"Size","position":1,"values":[{"name":"Single"},{"name":"4ft"},{"name":"Double"},{"name":"King"},{"name":"Super King"}]}],"variants":[{"optionValues":[{"optionName":"Size","name":"Single"}],"price":"9.99","position":1,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true}},{"optionValues":[{"optionName":"Size","name":"4ft"}],"price":"10.99","position":2,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true}},{"optionValues":[{"optionName":"Size","name":"Double"}],"price":"11.99","position":3,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true}},{"optionValues":[{"optionName":"Size","name":"King"}],"price":"12.99","position":4,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true}},{"optionValues":[{"optionName":"Size","name":"Super King"}],"price":"13.99","position":5,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true}}],"files":[{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/terry-fitting-corner.png?t=ec192f6ba7b523d85374ab46ed558dbb21e0f7c7436bb49f8743d54f66a980d5.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078850.fp&direct=1","alt":"Fitting the terry towel protector over a mattress corner","contentType":"IMAGE"},{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/terry-pinch.jpg?t=7b43d4814b5d3df655702da94b2f6bfae59a12164c04b3882440ac3d9aefb506.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078850.fp&direct=1","alt":"Close-up of the terry towel surface","contentType":"IMAGE"},{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/terry-fitting.jpg?t=4bde6c3de38148cae28ad1882bedd6880be8871bcb1586ed282ac9e736b4eb81.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078851.fp&direct=1","alt":"Terry towel protector being fitted","contentType":"IMAGE"}],"metafields":[{"namespace":"custom","key":"spec_line","type":"single_line_text_field","value":"100% waterproof · Terry towel · Aloe vera treated"}]},{"title":"Hotel Collection Duck Feather & Down Pillows","handle":"duck-feather-pillows","descriptionHtml":"<p>Hotel nights, every night. Natural duck feather and down in a 100% cotton, double-stitched cover — soft, supportive and sold in pairs.</p><ul><li>Natural duck feather and down fill</li><li>100% cotton cover, double stitched</li><li>Breathable, so you stay cool</li><li>For side, stomach and back sleepers</li><li>Machine washable on a cold wash</li></ul><h3>Description</h3><p>A balance of duck feather and down gives these pillows the right kind of softness, with enough support for your neck and shoulders. They suit side, stomach and back sleepers alike.</p><p>The fill sits directly inside a 100% cotton cover (it isn’t a separate case), double stitched to hold its shape and keep the feathers in. The cotton breathes, so air keeps moving and you stay comfortable all night.</p><h3>Specifications</h3><table><tbody><tr><th>Size</th><td>Standard, 48 × 74cm (19 × 29in)</td></tr><tr><th>Fill</th><td>Duck feather and down</td></tr><tr><th>Cover</th><td>100% cotton, double stitched</td></tr><tr><th>Colour</th><td>White</td></tr><tr><th>SKU</th><td>TBW06</td></tr></tbody></table><h3>Care</h3><ul><li>Machine washable on a cold wash.</li><li>Follow the care label for wash temperature and drying.</li></ul>","vendor":"Elovela","productType":"Hotel Collection","tags":["pillows"],"status":"ACTIVE","productOptions":[{"name":"Pack","position":1,"values":[{"name":"Pack of 2"},{"name":"Pack of 4"}]}],"variants":[{"optionValues":[{"optionName":"Pack","name":"Pack of 2"}],"price":"19.64","position":1,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true}},{"optionValues":[{"optionName":"Pack","name":"Pack of 4"}],"price":"34.64","position":2,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true}}],"files":[{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/pillows-stack-stool.png?t=186fd32ddb7ee4e52b5929250ca2b355eb520cf4a673a7831fbcd3bdef6bdf2e.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078851.fp&direct=1","alt":"Four duck feather and down pillows stacked on a stool","contentType":"IMAGE"},{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/pillow-feathers.jpg?t=3411d4f34ef79df7c9e5c14c883e99743fea01dbf6566fed82233627a1a3e080.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078852.fp&direct=1","alt":"Duck feathers and down","contentType":"IMAGE"},{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/pillow-fabric-detail.jpg?t=ce6062fb9766398fb9664090ad30ff934053149f40557aadd8809ccf856cd0c2.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078852.fp&direct=1","alt":"Close-up of the double-stitched cotton cover","contentType":"IMAGE"},{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/pillows-duvet-window.jpg?t=1d95805145c91e551b8b553283561bee5ee738560ad4a3c620c3b942100968b5.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078853.fp&direct=1","alt":"Pillows and duvet in window light","contentType":"IMAGE"},{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/pillow-joy.jpg?t=4b84de94406369f957f462b2151200925b5974773fed5a8fb63ff0016efac673.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078854.fp&direct=1","alt":"Woman hugging a pillow","contentType":"IMAGE"}],"metafields":[{"namespace":"custom","key":"spec_line","type":"single_line_text_field","value":"Standard 48 × 74cm · Duck feather & down · Pack of 2 or 4"}]},{"title":"U-Shape Pregnancy & Body Pillow","handle":"u-shape-pillow","descriptionHtml":"<p>Held, from bump to baby. A 3.7m U-shape that cradles you from head to toe, keeping your neck, shoulders, back and hips aligned.</p><ul><li>12ft / 3.7m long — cradles you from head to toe</li><li>Keeps neck, shoulders, back and hips aligned</li><li>Soft hollowfibre fill, microfibre outer</li><li>Removable cover</li><li>Hypoallergenic and chemical free</li><li>Lightweight and machine washable</li></ul><h3>Description</h3><p>The U-shaped body pillow gives comfort and support through pregnancy, or whenever your back, hips, shoulders or neck need a little more. Its shape cradles your body all night long, so you can settle and stay comfortable.</p><p>Soft hollowfibre filling sits inside a microfibre outer, with a removable cover for easy washing.</p><h3>Specifications</h3><table><tbody><tr><th>Length</th><td>12ft / 3.7m</td></tr><tr><th>Shape</th><td>U-shape (semicircular)</td></tr><tr><th>Fill</th><td>Polyester hollowfibre</td></tr><tr><th>Outer</th><td>Microfibre</td></tr><tr><th>Cover</th><td>Removable</td></tr><tr><th>Colour</th><td>White</td></tr><tr><th>SKU</th><td>TBW03</td></tr></tbody></table><h3>Care</h3><ul><li>Machine washable, with a removable cover.</li><li>Follow the care label for wash temperature and drying.</li></ul>","vendor":"Elovela","productType":"Support Pillows","tags":["pillows","support-pillows"],"status":"ACTIVE","productOptions":[{"name":"Colour","position":1,"values":[{"name":"White"}]}],"variants":[{"optionValues":[{"optionName":"Colour","name":"White"}],"price":"24.64","position":1,"inventoryPolicy":"DENY","taxable":true,"inventoryItem":{"tracked":false,"requiresShipping":true},"compareAtPrice":"27.99","sku":"TBW03"}],"files":[{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/u-shape-cutout.jpg?t=c4b5722718ab6365efb35f493bbab9229785b136fa3be7a8dbdeaa86a0440929.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078854.fp&direct=1","alt":"U-shape pregnancy and body pillow","contentType":"IMAGE"},{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/u-reading-sage.jpg?t=900f790f9cce474ae0487044047a429a8b8adf68f3802933010f0707479a9fea.314273ef-6d2b-4ed5-a1c0-f29421f4b313.d17e7416-0008-4c0b-9f65-f3dbbf9719ce.1792078855.fp&direct=1","alt":"Reading propped up in the U-shape pillow","contentType":"IMAGE"},{"originalSource":"https://2a5ca973-9828-44bf-81ac-9a9059cc2e20.claudeusercontent.com/v1/design/projects/2a5ca973-9828-44bf-81ac-9a9059cc2e20/serve/img/bump-sleeping.jpg?t=59ea2a70afd660cb1191c812a8cf5a6ee88d457be77e16dd30e