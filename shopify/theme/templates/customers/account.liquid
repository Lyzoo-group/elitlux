<section class="page-width section">
  <div class="account">
    <div class="stack-12">
      <p class="eyebrow">Your account</p>
      <h1 class="h1">Hello, {{ customer.first_name | default: customer.email }}</h1>
      <p class="small"><a href="{{ routes.account_addresses_url }}">Addresses ({{ customer.addresses_count }})</a> · <a href="{{ routes.account_logout_url }}">Log out</a></p>
    </div>
    <div class="stack-16">
      <h2 class="serif-24">Orders</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <div class="table-wrap">
            <table class="table">
              <thead><tr><th scope="col">Order</th><th scope="col">Date</th><th scope="col">Payment</th><th scope="col">Delivery</th><th scope="col">Total</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | date: '%d %B %Y' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- else -%}
          <p class="muted">You haven’t placed any orders yet.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="align-self:flex-start">Shop the collection</a>
        {%- endif -%}
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pages">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Newer</a>{%- endif -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Older</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>
