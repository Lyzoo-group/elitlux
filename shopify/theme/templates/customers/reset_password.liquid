<section class="page-width section">
  <div class="account account--narrow">
    <div class="panel stack-24">
      <h1 class="h2">Reset your password</h1>
      {%- form 'reset_customer_password', class: 'form' -%}
        {%- if form.errors -%}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field">
          <label for="ResetPassword">New password</label>
          <input id="ResetPassword" class="input" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label for="ResetConfirm">Confirm new password</label>
          <input id="ResetConfirm" class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
        <div class="form-actions"><button type="submit" class="btn btn--primary">Save password</button></div>
      {%- endform -%}
    </div>
  </div>
</section>
