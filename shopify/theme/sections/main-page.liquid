<section class="page-width page-generic" aria-labelledby="PageTitle">
  <h1 id="PageTitle" class="h-page">{{ page.title }}</h1>
  {%- if page.content != blank -%}
    <div class="rte">{{ page.content }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Page content",
  "settings": []
}
{% endschema %}
