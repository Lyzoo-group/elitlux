<div class="password">
  <div class="password__inner">
    <img src="{{ 'elovela-leaf.png' | asset_url }}" alt="" width="72" height="72">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1 class="h-page">{{ section.settings.heading }}{% if section.settings.heading_em != blank %} <em>{{ section.settings.heading_em }}</em>{% endif %}</h1>
    {%- if shop.password_message != blank -%}
      <p class="lede">{{ shop.password_message }}</p>
    {%- elsif section.settings.text != blank -%}
      <p class="lede">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- form 'customer', id: 'PasswordNewsletter', style: 'width:100%' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-status" role="status" style="color:var(--c-bg)">Thank you — we’ll let you know when we open.</p>
      {%- else -%}
        <div class="news-form">
          <label for="PasswordEmail" class="visually-hidden">Email address</label>
          <input id="PasswordEmail" type="email" name="contact[email]" autocomplete="email" placeholder="Email address" required>
          <button type="submit" class="btn btn--light">Tell me when you open</button>
        </div>
        {%- if form.errors -%}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary>Store owner? Enter the password</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label for="StorePassword" class="visually-hidden">Password</label>
        <input id="StorePassword" type="password" name="password" class="input" autocomplete="current-password" placeholder="Password" style="max-width:280px">
        <button type="submit" class="btn btn--outline-light">Enter</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Coming soon",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rest," },
    { "type": "text", "id": "heading_em", "label": "Heading, italic part", "default": "made lovely." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Hotel-quality comfort for UK homes. Our new shop opens soon." }
  ]
}
{% endschema %}
