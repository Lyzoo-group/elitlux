<section class="page-width section stack-16 align-start" aria-labelledby="NotFoundTitle">
  <p class="eyebrow">Not found</p>
  <h1 id="NotFoundTitle" class="h2">{{ section.settings.heading }}</h1>
  <p class="muted">{{ section.settings.text }}</p>
  <div class="btn-row">
    <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Shop all</a>
    <a href="{{ routes.search_url }}" class="btn btn--secondary">Search</a>
  </div>
</section>

{% schema %}
{
  "name": "Page not found",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We couldn’t find that page." },
    { "type": "text", "id": "text", "label": "Text", "default": "It may have moved, or the link may be out of date." }
  ]
}
{% endschema %}
