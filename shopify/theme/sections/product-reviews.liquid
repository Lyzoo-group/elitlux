<section class="bg-linen" aria-labelledby="Reviews-{{ section.id }}">
  <div class="page-width reviews">
    <div class="stack-12">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 id="Reviews-{{ section.id }}" class="h2-sm">{{ section.settings.heading }}</h2>
    </div>
    <div class="stack-12 align-start">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endfor -%}
      {%- else -%}
        <p class="serif-22">{{ section.settings.empty_heading }}</p>
        {%- if section.settings.empty_text != blank -%}<p class="muted">{{ section.settings.empty_text }}</p>{%- endif -%}
        {%- if settings.amazon_url != blank and section.settings.link_label != blank -%}
          <a href="{{ settings.amazon_url }}" class="link-arrow" target="_blank" rel="noopener">{{ section.settings.link_label }}{% render 'icon', name: 'arrow', size: 16 %}</a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "blocks": [ { "type": "@app" } ],
  "settings": [
    { "type": "paragraph", "content": "Add a reviews app block here once you install a reviews app. Until then, the message below shows." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "text", "id": "empty_heading", "label": "Message heading", "default": "No reviews on elovela.com yet." },
    { "type": "textarea", "id": "empty_text", "label": "Message", "default": "Reviews from customers who buy here will appear on this page. In the meantime, you can read what shoppers say about Elovela in our Amazon store." },
    { "type": "text", "id": "link_label", "label": "Amazon link label", "default": "Elovela on Amazon.co.uk" }
  ],
  "presets": [ { "name": "Reviews" } ]
}
{% endschema %}
