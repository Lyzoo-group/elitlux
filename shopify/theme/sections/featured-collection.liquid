{%- liquid
  assign c = section.settings.collection
  if c == blank
    assign c = collections.all
  endif
-%}
<section class="page-width section" aria-labelledby="Featured-{{ section.id }}">
  <div class="section-head">
    <h2 id="Featured-{{ section.id }}" class="h2">{{ section.settings.heading }}{% if section.settings.heading_em != blank %} <em>{{ section.settings.heading_em }}</em>{% endif %}</h2>
    {%- if section.settings.link_label != blank -%}
      <a href="{{ c.url | default: routes.all_products_collection_url }}" class="link-arrow">{{ section.settings.link_label }}{% render 'icon', name: 'arrow', size: 16 %}</a>
    {%- endif -%}
  </div>
  {%- if c.products.size > 0 -%}
    <ul class="grid-products grid-products--four" role="list">
      {%- for product in c.products limit: section.settings.limit -%}
        <li>{% render 'product-card', product: product, hide_spec: true, quick: true %}</li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    <p class="muted">Choose a collection for this section, or add products to your store.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "text", "id": "heading_em", "label": "Heading, italic part" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products. Tip: a collection sorted by Best selling works well here." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" }
  ],
  "presets": [ { "name": "Featured products" } ]
}
{% endschema %}
