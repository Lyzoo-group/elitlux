{%- assign img = section.settings.image -%}
<section class="home-hero" aria-labelledby="Hero-{{ section.id }}">
  {%- if img != blank -%}
    {{ img | image_url: width: 2600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600, 2000, 2600', sizes: '100vw', class: 'home-hero__img', alt: section.settings.image_alt }}
  {%- elsif section.settings.image_file != blank -%}
    {%- assign pic_style = 'object-position:' | append: section.settings.image_pos | default: center -%}{% render 'pic', file: section.settings.image_file, alt: section.settings.image_alt, class: 'home-hero__img', style: pic_style, loading: 'eager', sizes: '100vw' %}
  {%- endif -%}
  <div class="home-hero__scrim" aria-hidden="true"></div>
  <div class="page-width home-hero__inner">
    <div class="home-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 id="Hero-{{ section.id }}" class="h-display">{{ section.settings.heading }}{% if section.settings.heading_em != blank %} <em>{{ section.settings.heading_em }}</em>{% endif %}</h1>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
      <div class="btn-row">
        {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--light">{{ section.settings.button_label }}{% render 'icon', name: 'arrow', size: 18 %}</a>{%- endif -%}
        {%- if section.settings.button2_label != blank -%}<a href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}" class="btn btn--outline-light">{{ section.settings.button2_label }}</a>{%- endif -%}
      </div>
      {%- if section.settings.rating != blank -%}
      <p class="home-hero__rating"><span class="stars stars--sm" role="img" aria-label="Rated {{ section.settings.rating }} out of 5"><span class="stars__fill" style="width:{{ section.settings.rating | times: 20 }}%"></span></span><span><strong>Rated {{ section.settings.rating }} out of 5</strong> {{ section.settings.rating_note }}</span></p>
      {%- endif -%}
    </div>
    {%- assign lead = section.settings.lead_product -%}
    {%- if lead != blank -%}
    <div class="home-hero__lead">
      <a href="{{ lead.url }}" class="lead-card">
        {%- if lead.featured_media != blank -%}<span class="lead-card__img">{{ lead.featured_media.preview_image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy' }}</span>{%- endif -%}
        <span class="lead-card__text"><span class="eyebrow">{{ section.settings.lead_label }}</span><span class="lead-card__title">{{ lead.title }}</span><span class="small muted">From {{ lead.price_min | money }}</span></span>
      </a>
    </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Hotel-quality comfort for UK homes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rest," },
    { "type": "text", "id": "heading_em", "label": "Heading, italic part", "default": "made lovely." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pillows, toppers, duvets and protectors that bring the feeling of a hotel bed home." },
    { "type": "text", "id": "button_label", "label": "First button", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "First button link" },
    { "type": "text", "id": "button2_label", "label": "Second button", "default": "Find your topper" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "text", "id": "rating", "label": "Rating out of 5", "default": "4.6" },
    { "type": "text", "id": "rating_note", "label": "Rating note", "default": "by Cloud Topper customers on Amazon UK" },
    { "type": "product", "id": "lead_product", "label": "Product card (bottom right)" },
    { "type": "text", "id": "lead_label", "label": "Product card label", "default": "Hero range" },
    { "type": "image_picker", "id": "image", "label": "Background photo" },
    { "type": "text", "id": "image_file", "label": "Or a photo filename from the theme assets", "default": "topper-sleeping.jpg" },
    { "type": "text", "id": "image_pos", "label": "Photo focus (CSS object-position)", "default": "center" },
    { "type": "text", "id": "image_alt", "label": "Image description" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
