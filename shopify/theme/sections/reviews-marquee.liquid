{%- liquid
  assign reviews_a = 'Great Mattress Topper|Me and my husband love ours. Our mattress was just a bit too firm for me and this completely fixed it, like sleeping on a cloud! It feels very luxurious and plumps up well.|Sophia Evans|Super King;;Excellent topper|This topper was one of the cheapest I reviewed and much cheaper than my original purchase, so I was a little doubtful when I ordered it. I’m so glad I did, it is excellent.|SBLH|Double;;Perfect, Comfortable|We bought this to use in our motorhome and it has made such a difference - it’s so comfortable and cosy and we now sleep really well.|Kimsmum|Double;;Worth every penny|Actually amazed how comfy this is can’t feel the springs in my mattress anymore WOOOOOO feels like a cloud|Andrew Muir|Double;;Very comfortable.|Very comfortable mattress topper. I’m very pleased with it and now have a very good nights sleep with it on the bed. Good value for money and quality.|Mrs A E Armsworth|Double' | split: ';;'
  assign reviews_b = 'Made all the difference|Made all the difference to my flat mattress. Haven’t slept this good for ages|Suzy|Double;;Just what was needed|Had a mattress topper which was very thin and not very supportive. After reading reviews on this one, decided to give it a go. Last night was first time of using it and managed to get eight hours of sleep.|Stevemilsom|Double;;Very happy with this|Love it. Really nice quality, pretty thick, sturdy and has made my bed lovely and comfy.|Amazon Customer|King;;Really comfortable|Perfect fit and extremely comfortable well worth the money|Tony Singleton|Single;;Very comfortable|Really comfortable and revived an uncomfortable mattress|Shep|Small Double' | split: ';;'
  assign pct = section.settings.rating | times: 20
-%}
<section id="reviews" class="reviews-m" aria-labelledby="Reviews-{{ section.id }}">
  <div class="page-width reviews-m__inner">
    <div class="reviews-m__head">
      <div class="stack-12">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 id="Reviews-{{ section.id }}" class="h2">{{ section.settings.heading }}{% if section.settings.heading_em != blank %} <em>{{ section.settings.heading_em }}</em>{% endif %}</h2>
      </div>
      <div class="reviews-m__rating">
        <p class="reviews-m__big">{{ section.settings.rating }}</p>
        <div class="stack-8">
          <div class="stars" role="img" aria-label="Rated {{ section.settings.rating }} out of 5"><span class="stars__fill" style="width:{{ pct }}%"></span></div>
          <p class="small muted">{{ section.settings.rating_note }}</p>
        </div>
      </div>
    </div>
    <div class="marquee-wrap">
      <div class="marquee"><ul class="marquee__track marquee__track--left" role="list" aria-label="Customer reviews">
        {%- for i in (1..2) -%}{%- for r in reviews_a -%}{%- assign f = r | split: '|' -%}
        <li class="rcard"><div class="stars stars--sm" role="img" aria-label="5 out of 5 stars"><span class="stars__fill" style="width:100%"></span></div><h3>{{ f[0] }}</h3><p>“{{ f[1] }}”</p><p class="rcard__who"><strong>{{ f[2] }}</strong><span>Verified purchase · {{ f[3] }}</span></p></li>
        {%- endfor -%}{%- endfor -%}
      </ul></div>
      {%- if section.settings.two_rows -%}
      <div class="marquee"><ul class="marquee__track marquee__track--right" role="list" aria-label="More customer reviews">
        {%- for i in (1..2) -%}{%- for r in reviews_b -%}{%- assign f = r | split: '|' -%}
        <li class="rcard"><div class="stars stars--sm" role="img" aria-label="5 out of 5 stars"><span class="stars__fill" style="width:100%"></span></div><h3>{{ f[0] }}</h3><p>“{{ f[1] }}”</p><p class="rcard__who"><strong>{{ f[2] }}</strong><span>Verified purchase · {{ f[3] }}</span></p></li>
        {%- endfor -%}{%- endfor -%}
      </ul></div>
      {%- endif -%}
    </div>
    {%- if settings.amazon_url != blank -%}<a href="{{ settings.amazon_url }}" target="_blank" rel="noopener" class="link-arrow reviews-m__link">All reviews on Amazon{% render 'icon', name: 'arrow', size: 16 %}</a>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "paragraph", "content": "Ten verified Cloud Topper reviews from Amazon UK are built in. Ask us to update them when you have more." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Cloud Topper reviews · Amazon UK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "“Like sleeping on" },
    { "type": "text", "id": "heading_em", "label": "Heading, italic part", "default": "a cloud.”" },
    { "type": "text", "id": "rating", "label": "Rating out of 5", "default": "4.6" },
    { "type": "text", "id": "rating_note", "label": "Rating note", "default": "out of 5 on Amazon UK" },
    { "type": "checkbox", "id": "two_rows", "label": "Show two rows", "default": true }
  ],
  "presets": [ { "name": "Reviews" } ]
}
{% endschema %}
