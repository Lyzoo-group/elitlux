{%- liquid
  assign menu = linklists[section.settings.menu]
  assign secondary = linklists[section.settings.secondary_menu]
  assign columns = section.blocks | where: 'type', 'column'
  assign promo = section.settings.promo_product
-%}
{%- capture logo -%}
  {%- if section.settings.logo != blank -%}
    {{ section.settings.logo | image_url: width: 480 | image_tag: alt: shop.name, widths: '160, 240, 320, 480', sizes: '240px', loading: 'eager' }}
  {%- else -%}
    <img src="{{ 'elovela-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="108" height="73" loading="eager">
  {%- endif -%}
{%- endcapture -%}
<header class="site-header" data-header style="--logo-h: {{ section.settings.logo_height }}px">
  <div class="page-width site-header__bar">
    <button type="button" class="icon-btn site-header__menu-btn" data-open="MobileNav" aria-controls="MobileNav" aria-expanded="false" aria-label="Open menu">
      {%- render 'icon', name: 'menu', size: 24 -%}
    </button>
    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name | escape }}, home">{{ logo }}</a>
    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list" role="list">
        {%- if columns.size > 0 -%}
          <li>
            <button type="button" class="site-nav__link" data-mega aria-expanded="false" aria-controls="MegaMenu">
              {{- section.settings.mega_label -}}
              {%- render 'icon', name: 'chevron-down', size: 16 -%}
            </button>
          </li>
        {%- endif -%}
        <li><a href="{{ routes.root_url }}" class="site-nav__link" data-mega-close{% if request.page_type == 'index' %} aria-current="page"{% endif %}>Home</a></li>
        {%- for link in menu.links -%}
          <li><a href="{{ link.url }}" class="site-nav__link" data-mega-close{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="site-header__actions">
      {%- if secondary.links.size > 0 -%}
        {%- for link in secondary.links -%}
          <a href="{{ link.url }}" class="site-header__text-link" data-mega-close>{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- if pages.about.url != blank -%}<a href="{{ pages.about.url }}" class="site-header__text-link" data-mega-close>About</a>{%- endif -%}
        {%- if pages.contact.url != blank -%}<a href="{{ pages.contact.url }}" class="site-header__text-link" data-mega-close>Help</a>{%- endif -%}
      {%- endif -%}
      <a href="{{ routes.search_url }}" class="icon-btn" aria-label="Search">{% render 'icon', name: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-btn site-header__account" aria-label="{% if customer %}Your account{% else %}Log in{% endif %}">{% render 'icon', name: 'user' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-btn" data-cart-link{% if settings.cart_type == 'drawer' %} data-open="CartDrawer" aria-controls="CartDrawer" aria-expanded="false"{% endif %} aria-label="Bag, {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}">
        {%- render 'icon', name: 'bag' -%}
        <span class="count-bubble" data-cart-count aria-hidden="true"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
  {%- if columns.size > 0 -%}
    <div class="mega" id="MegaMenu" hidden>
      <div class="page-width mega__inner" style="--cols: {{ columns.size }}">
        {%- for block in columns -%}
          {%- assign c = block.settings.collection -%}
          <div class="mega__col" {{ block.shopify_attributes }}>
            <p class="eyebrow">{% if block.settings.heading != blank %}{{ block.settings.heading }}{% elsif c != blank %}{{ c.title }}{% endif %}</p>
            {%- if c != blank -%}
              <ul class="mega__list" role="list">
                {%- for p in c.products limit: block.settings.limit -%}
                  <li><a href="{{ p.url }}">{{ p.title }}</a></li>
                {%- endfor -%}
                <li><a href="{{ c.url }}" class="mega__all">{{ block.settings.all_label }}</a></li>
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
        {%- if promo != blank -%}
          <a href="{{ promo.url }}" class="mega__promo">
            {%- if promo.featured_media != blank -%}
              {{ promo.featured_media.preview_image | image_url: width: 240 | image_tag: alt: '', loading: 'lazy' }}
            {%- endif -%}
            <span class="mega__promo-text">
              {%- if section.settings.promo_eyebrow != blank -%}<span class="eyebrow">{{ section.settings.promo_eyebrow }}</span>{%- endif -%}
              <span class="h3">{{ section.settings.promo_heading }}{% if section.settings.promo_heading_em != blank %} <em>{{ section.settings.promo_heading_em }}</em>{% endif %}</span>
              <span class="small muted">{{ promo.title }} · {% if promo.price_varies %}from {% endif %}{{ promo.price_min | money }}</span>
            </span>
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</header>

<div class="dialog dialog--left" id="MobileNav" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="dialog__overlay" data-close></div>
  <div class="dialog__panel">
    <div class="dialog__head">
      {{ logo }}
      <button type="button" class="icon-btn" data-close data-autofocus aria-label="Close menu">{% render 'icon', name: 'close' %}</button>
    </div>
    <nav class="mobile-nav" aria-label="Mobile">
      <p class="eyebrow">{{ section.settings.mega_label }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="mobile-nav__link">Shop all</a>
      {%- for link in menu.links -%}
        <a href="{{ link.url }}" class="mobile-nav__link">{{ link.title }}</a>
      {%- endfor -%}
      <p class="eyebrow mobile-nav__group">{{ shop.name }}</p>
      {%- if secondary.links.size > 0 -%}
        {%- for link in secondary.links -%}
          <a href="{{ link.url }}" class="mobile-nav__link mobile-nav__link--small">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- if pages.about.url != blank -%}<a href="{{ pages.about.url }}" class="mobile-nav__link mobile-nav__link--small">About {{ shop.name }}</a>{%- endif -%}
        {%- if pages.contact.url != blank -%}<a href="{{ pages.contact.url }}" class="mobile-nav__link mobile-nav__link--small">Help &amp; contact</a>{%- endif -%}
      {%- endif -%}
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="mobile-nav__link mobile-nav__link--small">{% if customer %}Your account{% else %}Log in{% endif %}</a>
      {%- endif -%}
      {%- if settings.amazon_url != blank -%}
        <a href="{{ settings.amazon_url }}" class="mobile-nav__link mobile-nav__link--small" target="_blank" rel="noopener">{{ shop.name }} on Amazon UK</a>
      {%- endif -%}
    </nav>
    <div class="mobile-nav__foot">
      <p>{{ settings.delivery_message }}</p>
      <p class="muted">{{ settings.help_message }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "max_blocks": 5,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "The Elovela logo is used until you upload one. Upload a larger PNG for sharper screens." },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 32, "max": 72, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Menus" },
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "link_list", "id": "secondary_menu", "label": "Small links on the right", "info": "For example About and Help. If empty, links to your About and Contact pages appear." },
    { "type": "header", "content": "Shop menu" },
    { "type": "paragraph", "content": "Add a Shop menu column for each collection you want in the drop-down." },
    { "type": "text", "id": "mega_label", "label": "Label", "default": "Shop" },
    { "type": "product", "id": "promo_product", "label": "Featured product" },
    { "type": "text", "id": "promo_eyebrow", "label": "Featured product label", "default": "Hero range" },
    { "type": "text", "id": "promo_heading", "label": "Featured product heading", "default": "Your bed," },
    { "type": "text", "id": "promo_heading_em", "label": "Heading, italic part", "default": "made new." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Shop menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "range", "id": "limit", "label": "Products to list", "min": 2, "max": 8, "step": 1, "default": 5 },
        { "type": "text", "id": "all_label", "label": "Link to collection", "default": "Shop all" }
      ]
    }
  ]
}
{% endschema %}
