<section class="ranges" aria-labelledby="Tiles-{{ section.id }}">
  <div class="page-width ranges__inner">
    <div class="section-head ranges__head">
      <div class="stack-12">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="Tiles-{{ section.id }}" class="h2-lg">{{ section.settings.heading }}{% if section.settings.heading_em != blank %} <em>{{ section.settings.heading_em }}</em>{% endif %}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="link-arrow link-arrow--dark">{{ section.settings.link_label }}{% render 'icon', name: 'arrow', size: 16 %}</a>{%- endif -%}
    </div>
    {%- liquid
      assign bigs = ''
      assign smalls = ''
    -%}
    <ul class="ranges__big" role="list">
      {%- for block in section.blocks limit: 2 -%}
        {%- liquid
          assign c = block.settings.collection
          assign min = 999999999
          if c != blank
            for p in c.products limit: 50
              if p.price_min < min
                assign min = p.price_min
              endif
            endfor
          endif
          assign pos = block.settings.image_pos | default: 'center'
          assign pic_style = 'object-position:' | append: pos
        -%}
        <li {{ block.shopify_attributes }}>
          <a href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="rtile rtile--big">
            {%- if block.settings.image_file != blank -%}{% render 'pic', file: block.settings.image_file, alt: '', class: 'media-fill', style: pic_style, loading: 'lazy', sizes: '50vw' %}{%- elsif c.image != blank -%}{{ c.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'media-fill', alt: '' }}{%- endif -%}
            <span class="rtile__shade rtile__shade--big" aria-hidden="true"></span>
            <span class="rtile__body rtile__body--big">
              <span class="stack-8">
                <span class="eyebrow">{{ block.settings.label }}</span>
                <span class="rtile__title rtile__title--big">{% if c != blank %}{{ c.title }}{% else %}Collection{% endif %}</span>
                <span class="rtile__need">{{ block.settings.need }}</span>
              </span>
              <span class="rtile__from rtile__from--big">{% if min < 999999999 %}From {{ min | money }}{% else %}Shop{% endif %}{% render 'icon', name: 'arrow', size: 18 %}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    <ul class="ranges__small" role="list">
      {%- for block in section.blocks offset: 2 -%}
        {%- liquid
          assign c = block.settings.collection
          assign min = 999999999
          if c != blank
            for p in c.products limit: 50
              if p.price_min < min
                assign min = p.price_min
              endif
            endfor
          endif
          assign pos = block.settings.image_pos | default: 'center'
          assign pic_style = 'object-position:' | append: pos
        -%}
        <li {{ block.shopify_attributes }}>
          <a href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="rtile rtile--small">
            {%- if block.settings.image_file != blank -%}{% render 'pic', file: block.settings.image_file, alt: '', class: 'media-fill', style: pic_style, loading: 'lazy', sizes: '25vw' %}{%- elsif c.image != blank -%}{{ c.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'media-fill', alt: '' }}{%- endif -%}
            <span class="rtile__shade rtile__shade--small" aria-hidden="true"></span>
            <span class="rtile__from rtile__from--small">{% if min < 999999999 %}From {{ min | money }}{% else %}Shop{% endif %}</span>
            <span class="rtile__body rtile__body--small">
              <span class="eyebrow">{{ block.settings.label }}</span>
              <span class="rtile__title rtile__title--small">{% if c != blank %}{{ c.title }}{% else %}Collection{% endif %}</span>
              <span class="rtile__need rtile__need--small">{{ block.settings.need }}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Shop by range",
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "The first two blocks are the large tiles; the rest form the small row." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Shop by range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six ways to" },
    { "type": "text", "id": "heading_em", "label": "Heading, italic part", "default": "a better night" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "collection", "name": "Range tile", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Small label" },
      { "type": "text", "id": "need", "label": "Need line", "default": "Mattress too firm, or tired? Add 10cm of softness." },
      { "type": "text", "id": "image_file", "label": "Photo filename (Content → Files)" },
      { "type": "text", "id": "image_pos", "label": "Photo focus", "default": "center" }
    ] }
  ],
  "presets": [ { "name": "Shop by range", "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ] } ]
}
{% endschema %}
