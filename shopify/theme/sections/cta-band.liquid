<section class="bg-forest" aria-labelledby="Cta-{{ section.id }}">
  <div class="page-width cta">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 id="Cta-{{ section.id }}" class="h2-lg">{{ section.settings.heading }}{% if section.settings.heading_em != blank %} <em>{{ section.settings.heading_em }}</em>{% endif %}</h2>
    {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
      <div class="btn-row">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--light">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank and section.settings.button2_link != blank -%}
          <a href="{{ section.settings.button2_link }}" class="btn btn--outline-light">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.note != blank and settings.amazon_url != blank -%}
      <p class="cta__note">{{ section.settings.note }} <a href="{{ settings.amazon_url }}" target="_blank" rel="noopener">{{ section.settings.note_link }}</a>.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Closing banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Rest, made lovely" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Softness you can feel." },
    { "type": "text", "id": "heading_em", "label": "Heading, italic part", "default": "Quality you can trust." },
    { "type": "text", "id": "button_label", "label": "First button", "default": "Shop all" },
    { "type": "url", "id": "button_link", "label": "First button link", "default": "/collections/all" },
    { "type": "text", "id": "button2_label", "label": "Second button", "default": "Ask us anything" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "header", "content": "Amazon note" },
    { "type": "text", "id": "note", "label": "Text", "default": "Prefer Amazon? The full range is also in the" },
    { "type": "text", "id": "note_link", "label": "Link text", "default": "Elovela Store on Amazon.co.uk", "info": "Links to the Amazon store set in Theme settings." }
  ],
  "presets": [ { "name": "Closing banner" } ]
}
{% endschema %}
