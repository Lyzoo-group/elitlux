{%- if section.blocks.size > 0 -%}
  <div class="announcement" role="region" aria-label="Announcements">
    {%- for block in section.blocks -%}
      {%- unless forloop.first -%}<span class="announcement__dot" aria-hidden="true">·</span>{%- endunless -%}
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
      {%- else -%}
        <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery on every order" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Announcement bar", "blocks": [ { "type": "message" } ] }
  ]
}
{% endschema %}
