{%- liquid
  assign has_social = false
  if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank
    assign has_social = true
  endif
-%}
<footer class="site-footer">
  <img src="{{ 'elovela-leaf.png' | asset_url }}" alt="" aria-hidden="true" class="footer__leaf" width="270" height="270" loading="lazy">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          <img src="{{ 'elovela-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="108" height="73" loading="lazy">
        {%- endif -%}
        {%- if section.settings.text != blank -%}<p class="small muted">{{ section.settings.text }}</p>{%- endif -%}
        {%- if has_social -%}
          <p class="small muted social">
            <span>Follow us on</span>
            {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
            {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
          </p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_offer -%}
        <div class="footer__offer">
          <p class="eyebrow eyebrow--brass">{{ section.settings.offer_eyebrow }}</p>
          <p class="serif-24">{{ section.settings.offer_heading }} <em>{{ section.settings.offer_heading_em }}</em></p>
          <p class="small muted">{{ section.settings.offer_text }}</p>
          <a href="{{ routes.root_url }}#offer" class="link-arrow link-arrow--dark">{{ section.settings.offer_link }}{% render 'icon', name: 'arrow', size: 16 %}</a>
        </div>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="footer__cols">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- assign m = linklists[block.settings.menu] -%}
              <nav class="footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
                <p class="eyebrow">{{ block.settings.heading }}</p>
                {%- for link in m.links -%}
                  <a href="{{ link.url }}">{{ link.title }}</a>
                {%- endfor -%}
              </nav>
            {%- when 'company' -%}
              <address class="footer__col" {{ block.shopify_attributes }}>
                <p class="eyebrow">{{ block.settings.heading }}</p>
                {%- if block.settings.legal_name != blank -%}<p>{{ block.settings.legal_name }}</p>{%- endif -%}
                {%- if block.settings.reg != blank -%}<p class="muted">{{ block.settings.reg }}</p>{%- endif -%}
                {%- if settings.business_address != blank -%}<p class="muted">{{ settings.business_address | newline_to_br }}</p>{%- endif -%}
              </address>
            {%- when 'contact' -%}
              <div class="footer__col" {{ block.shopify_attributes }}>
                <p class="eyebrow">{{ block.settings.heading }}</p>
                {%- if settings.support_email != blank -%}<a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a>{%- endif -%}
                {%- if settings.support_phone != blank -%}<a href="tel:{{ settings.support_phone | remove: ' ' }}">{{ settings.support_phone }}</a>{%- endif -%}
                {%- if settings.support_hours != blank -%}<p class="muted">{{ settings.support_hours }}</p>{%- endif -%}
                {%- if pages.contact.url != blank -%}<a href="{{ pages.contact.url }}">Send us a message</a>{%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="footer__bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      {%- if shop.policies.size > 0 -%}
        <nav aria-label="Policies">
          {%- for policy in shop.policies -%}
            <a href="{{ policy.url }}">{{ policy.title }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "textarea", "id": "text", "label": "About text", "default": "Elovela delivers thoughtfully crafted comfort products designed to enhance your sleep and everyday relaxation with quality you can trust." },
    { "type": "header", "content": "Welcome offer column" },
    { "type": "checkbox", "id": "show_offer", "label": "Show welcome offer", "default": true },
    { "type": "text", "id": "offer_eyebrow", "label": "Small label", "default": "Welcome offer" },
    { "type": "text", "id": "offer_heading", "label": "Heading", "default": "10% off" },
    { "type": "text", "id": "offer_heading_em", "label": "Heading, italic part", "default": "your first order." },
    { "type": "text", "id": "offer_text", "label": "Text", "default": "Join our list on the homepage and we’ll email your code straight away." },
    { "type": "text", "id": "offer_link", "label": "Link label", "default": "Get 10% off" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "company",
      "name": "Company column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Company" },
        { "type": "text", "id": "legal_name", "label": "Legal name", "default": "Elovali Limited, trading as Elovela" },
        { "type": "text", "id": "reg", "label": "Registration", "default": "Registered in Scotland, company no. SC844987" },
        { "type": "paragraph", "content": "The address comes from Theme settings → Contact details." }
      ]
    },
    {
      "type": "contact",
      "name": "Contact column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Help, 24/7" },
        { "type": "paragraph", "content": "Shows the contact details from Theme settings." }
      ]
    }
  ]
}
{% endschema %}
