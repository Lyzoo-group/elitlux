{%- liquid
  assign s = section.settings
  assign rpct = settings.rating | times: 20
-%}
<section id="{{ s.anchor | default: 'reviews' }}" class="rev"{% if s.overlap %} data-ovl{% elsif s.rounded %} data-round{% endif %} aria-labelledby="rev-title-{{ section.id }}" style="z-index:{{ section.index }}">
  <div class="rev__in">
    <div class="rev__head">
      <div class="rev__t">
        <p class="ey">{{ s.eyebrow }}</p>
        <h2 id="rev-title-{{ section.id }}" class="rev__h">{{ s.heading }} <em class="em-navy">{{ s.heading_em }}</em>{{ s.heading_after }}</h2>
      </div>
      {%- if settings.rating != blank -%}
        {%- assign rl = 'Rated ' | append: settings.rating | append: ' out of 5' -%}
        <div class="rev__score">
          <div class="rev__score-in">
            <p class="rev__big">{{ settings.rating }}</p>
            <div class="rev__stars">{% render 'stars', w: 120, h: 24, base: '#E3E9F2', pct: rpct, tag: 'div', label: rl %}<p class="rev__of">{{ s.rating_text }}</p></div>
          </div>
        </div>
      {%- endif -%}
    </div>
    <div class="rev__rows">
      {%- for row in (1..2) -%}
        {%- liquid
          assign rkey = 'row_' | append: row
          assign aria = s.row_1_label
          if row == 2
            assign aria = s.row_2_label
          endif
        -%}
        <div class="rev__vp">
          <ul role="list" aria-label="{{ aria | escape }}" class="rev__track rev__track--{{ row }}" data-marquee>
            {%- for copy in (1..2) -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign br = block.settings.row | append: ''
                  assign want = row | append: ''
                -%}
                {%- if br == want -%}
                  <li class="rev__card"{% if copy == 1 %} {{ block.shopify_attributes }}{% endif %}>
                    <div role="img" aria-label="5 out of 5 stars" class="rev__five"><svg viewBox="0 0 120 24" width="80" height="16" aria-hidden="true">{%- render 'star-paths' -%}</svg></div>
                    <h3 class="rev__ct">{{ block.settings.title }}</h3>
                    <p class="rev__q">“{{ block.settings.text }}”</p>
                    <p class="rev__by"><span class="rev__name">{{ block.settings.name }}</span><span>{{ block.settings.meta }}</span></p>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    {%- if s.link_label != blank and settings.amazon_url != blank -%}
      <a href="{{ settings.amazon_url }}" target="_blank" rel="noopener" class="rev__link">{{ s.link_label }}{% render 'icon', i: 'arrow', s: 16, w: 1.5 %}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "class": "rev-sec",
  "settings": [
    { "type": "checkbox", "id": "overlap", "label": "Overlap the section above with a rounded top", "default": false },
    { "type": "checkbox", "id": "rounded", "label": "Rounded top corners (without overlapping)", "default": true },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "reviews" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mattress Protector reviews · Amazon UK" },
    { "type": "text", "id": "heading", "label": "Heading, before the italic part", "default": "“Stays where" },
    { "type": "text", "id": "heading_em", "label": "Heading, italic part", "default": "it should!" },
    { "type": "text", "id": "heading_after", "label": "Heading, after the italic part", "default": "”" },
    { "type": "text", "id": "rating_text", "label": "Text under the stars", "default": "out of 5 on Amazon UK", "info": "The rating shows only when filled in under Theme settings → Ratings." },
    { "type": "text", "id": "row_1_label", "label": "Accessible name, row 1", "default": "Customer reviews" },
    { "type": "text", "id": "row_2_label", "label": "Accessible name, row 2", "default": "More customer reviews" },
    { "type": "text", "id": "link_label", "label": "Link to all reviews (uses the Amazon store link in Theme settings)", "default": "All reviews on Amazon" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "select", "id": "row", "label": "Row", "options": [{ "value": "1", "label": "Row 1 (moves left)" }, { "value": "2", "label": "Row 2 (moves right)" }], "default": "1" },
        { "type": "text", "id": "title", "label": "Title", "default": "Very good buy" },
        { "type": "textarea", "id": "text", "label": "Review" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "meta", "label": "Details", "default": "Verified purchase · Double" }
      ]
    }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
