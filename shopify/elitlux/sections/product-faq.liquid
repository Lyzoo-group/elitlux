{%- liquid
  assign s = section.settings
  assign faqs = product.metafields.custom.faqs.value
  assign has_why = false
  if product.metafields.custom.benefits != blank
    assign has_why = true
  endif
  assign has_cmp = false
  assign cmp = product.metafields.custom.compare.value
  if cmp != blank and cmp.cols.size > 1
    assign has_cmp = true
  endif
  assign ovl = false
  if s.overlap and has_why and has_cmp == false
    assign ovl = true
  endif
  assign short = product.metafields.custom.short_name.value | default: product.type | downcase
-%}
{%- if faqs != blank -%}
<section class="faq{% unless ovl %} faq--line{% endunless %}"{% if ovl %} data-ovl{% endif %} aria-labelledby="faq-title" style="z-index:{{ section.index }}">
  <div class="faq__in">
    <div class="faq__head"><p class="ey">{{ s.eyebrow }}</p><h2 id="faq-title" class="h2m">{{ s.heading }} {{ short }}</h2><p class="faq__ask">{{ s.ask_before }} <a href="{{ s.ask_link }}">{{ s.ask_link_text }}</a>{{ s.ask_after }}</p></div>
    <div class="faq__list">
      {%- for f in faqs -%}
        <details class="faq__it"><summary class="faq__q">{{ f.q }}{% render 'icon', i: 'plus-faq', s: 20, w: 1.5 %}</summary><p class="faq__a">{{ f.a }}</p></details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product questions",
  "class": "faq-sec",
  "settings": [
    { "type": "paragraph", "content": "Questions come from custom.faqs. It overlaps “Why choose it” only when that shows and the comparison doesn't; otherwise it has a thin top line, as in the design." },
    { "type": "checkbox", "id": "overlap", "label": "Overlap the section above with a rounded top (when allowed)", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading (product short name is added)", "default": "Questions about the" },
    { "type": "text", "id": "ask_before", "label": "Help line, before the link", "default": "Anything else?" },
    { "type": "text", "id": "ask_link_text", "label": "Help line, link", "default": "Ask us" },
    { "type": "url", "id": "ask_link", "label": "Help line, link target" },
    { "type": "text", "id": "ask_after", "label": "Help line, after the link", "default": ", we’re here 24/7." }
  ]
}
{% endschema %}
