{%- liquid
  assign s = section.settings
  assign sugs = s.suggestions | split: ','
-%}
<section class="srch" aria-labelledby="search-title" style="z-index:{{ section.index }}">
  <h1 id="search-title" class="cart__h">{{ s.title }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="srch__form">
    <label for="q" class="vh">Search products</label>
    {% render 'icon', i: 'search', s: 22, w: 1.5, cls: 'srch__ico' %}
    <input id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ s.placeholder | escape }}" autocomplete="off" class="srch__in" data-autofocus-search>
    <input type="hidden" name="type" value="product">
  </form>
  {%- if search.performed == false or search.terms == blank -%}
    <div class="srch__try"><p class="srch__try-l">Try</p>{%- for t in sugs -%}{%- assign tt = t | strip -%}<a href="{{ routes.search_url }}?q={{ tt | url_encode }}&amp;type=product" class="srch__sug">{{ tt }}</a>{%- endfor -%}</div>
  {%- else -%}
    <p aria-live="polite" class="srch__count">{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %} for “{{ search.terms | escape }}”</p>
    {%- if search.results_count == 0 -%}
      <div class="srch__none">
        <p class="srch__none-h">Nothing matches “{{ search.terms | escape }}”.</p>
        <p class="cart__muted">{{ s.none_text }}</p>
        <a href="{{ s.none_link }}" class="srch__none-b">{{ s.none_button }}</a>
      </div>
    {%- endif -%}
  {%- endif -%}
  {%- if search.performed and search.results_count > 0 -%}
    {%- paginate search.results by 24 -%}
      <ul role="list" class="srch__grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'card-small', product: item %}{%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}<nav class="grid__pages" aria-label="Pages">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search",
  "class": "srch-sec",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Search" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Search toppers, pillows, protectors…" },
    { "type": "text", "id": "suggestions", "label": "Suggestions (comma separated)", "default": "Mattress topper, U-shape pillow, Waterproof protector, 13.5 tog duvet, Cushion pad" },
    { "type": "text", "id": "none_text", "label": "No results text", "default": "Try a simpler word like topper, pillow, protector or duvet, or ask us. We’re here 24/7." },
    { "type": "text", "id": "none_button", "label": "No results button", "default": "Contact us" },
    { "type": "url", "id": "none_link", "label": "No results button link" }
  ]
}
{% endschema %}
