{%- liquid
  assign s = section.settings
-%}
<section class="ab-for" aria-labelledby="for-title-{{ section.id }}" style="z-index:{{ section.index }}">
  <div class="ab-for__in">
    <div class="ab-for__head"><p class="ey">{{ s.eyebrow }}</p><h2 id="for-title-{{ section.id }}" class="h2s">{{ s.heading }} <em class="em-navy">{{ s.heading_em }}</em></h2></div>
    <ul role="list" class="ab-for__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign url = '#'
          if c != blank
            assign url = c.url
          endif
        -%}
        <li {{ block.shopify_attributes }}><a href="{{ url }}" class="ab-for__a"><span class="ab-for__t">{{ block.settings.title }}</span><span class="ab-for__p">{{ block.settings.text }}</span><span class="ab-for__l">{{ block.settings.link_label }}</span></a></li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Who it’s for",
  "class": "ab-for-sec",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Who we make it for" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the way" },
    { "type": "text", "id": "heading_em", "label": "Heading, italic part", "default": "you sleep" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Refreshing a tired bed" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "link_label", "label": "Link text", "default": "Shop toppers →" }
    ] }
  ],
  "presets": [{ "name": "Who it’s for" }]
}
{% endschema %}
