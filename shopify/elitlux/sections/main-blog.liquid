<section class="pg" style="z-index:{{ section.index }}">
  <h1 class="cart__h">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul role="list" class="srch__grid">
      {%- for article in blog.articles -%}
        <li class="sc">
          <a href="{{ article.url }}" class="sc__img">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'cover zoom', widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 23vw, 48vw' }}{%- endif -%}</a>
          <div class="sc__t"><p class="ey ey--11">{{ article.published_at | date: '%-d %B %Y' }}</p><h2 class="sc__h"><a href="{{ article.url }}">{{ article.title }}</a></h2></div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}<nav class="grid__pages" aria-label="Pages">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Blog", "class": "pg-sec", "settings": [] }
{% endschema %}
