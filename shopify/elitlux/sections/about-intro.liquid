{%- liquid
  assign s = section.settings
-%}
<section class="ab-intro" aria-labelledby="about-title" style="z-index:{{ section.index }}">
  <div class="ab-intro__t">
    <p class="ey">{{ s.eyebrow }}</p>
    <h1 id="about-title" class="pg-h1">{{ s.heading }} <em class="em-navy">{{ s.heading_em }}</em></h1>
  </div>
  <p class="ab-intro__p">{{ s.text }}</p>
</section>

{% schema %}
{
  "name": "Page intro (two columns)",
  "class": "ab-intro-sec",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Elitlux" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Comfort is" },
    { "type": "text", "id": "heading_em", "label": "Heading, italic part", "default": "not a luxury." },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Page intro (two columns)" }]
}
{% endschema %}
