{%- liquid
  assign s = section.settings
  assign cpg = collection.metafields.custom.page.value
  assign cross = cpg.cross
-%}
{%- if cross != blank -%}
<section class="cross" aria-labelledby="cross-title" style="z-index:{{ section.index }}">
  <div class="sec-head">
    <div class="sec-head__t">
      <p class="ey">{{ s.eyebrow }}</p>
      <h2 id="cross-title" class="h2x cross__h">{{ s.heading }}</h2>
    </div>
    {%- if s.link_label != blank -%}<a href="{{ s.link }}" class="alink">{{ s.link_label }}{% render 'icon', i: 'arrow' %}</a>{%- endif -%}
  </div>
  <ul role="list" class="cross__list">
    {%- for h in cross -%}
      {%- liquid
        assign xc = collections[h]
        assign card = xc.metafields.custom.page.value.card
        assign cf = card.file
        assign minp = 999999999
        for p in xc.products limit: 50
          if p.price_min < minp
            assign minp = p.price_min
          endif
        endfor
      -%}
      {%- if xc.id != blank -%}
      <li class="cross__it" data-reveal>
        <a href="{{ xc.url }}" class="cross__a">
          <span class="cross__img">{% render 'img', file: cf, alt: '', class: 'cover', sizes: '(min-width: 1000px) 12vw, 40vw', widths: '300, 450, 600' %}</span>
          <span class="cross__t">
            <span class="ey">{{ card.label }}</span>
            <span class="cross__name">{{ card.title | default: xc.title }}</span>
            <span class="cross__tag">{{ card.tagline }}</span>
            <span class="cross__from">{% if minp < 999999999 %}From {{ minp | money }}{% endif %}{% render 'icon', i: 'arrow' %}</span>
          </span>
        </a>
      </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Complete your bed",
  "class": "cross-sec",
  "settings": [
    { "type": "paragraph", "content": "The three ranges come from the collection's custom.page metafield (cross)." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pairs well with" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete your bed" },
    { "type": "text", "id": "link_label", "label": "Link", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "Link target", "default": "/collections/all" }
  ]
}
{% endschema %}
