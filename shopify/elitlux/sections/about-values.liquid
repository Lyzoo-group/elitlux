{%- liquid
  assign s = section.settings
-%}
<section class="ab-vals" aria-labelledby="vals-title-{{ section.id }}" style="z-index:{{ section.index }}">
  <div class="ab-vals__head"><p class="ey">{{ s.eyebrow }}</p><h2 id="vals-title-{{ section.id }}" class="h2s">{{ s.heading }}</h2></div>
  <ul role="list" class="ab-vals__list">
    {%- for block in section.blocks -%}
      <li class="ab-vals__it" {{ block.shopify_attributes }}><h3 class="ab-vals__h">{{ block.settings.title }}</h3><p class="ab-vals__p">{{ block.settings.text }}</p></li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Values",
  "class": "ab-vals-sec",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our values" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we stand for" }
  ],
  "blocks": [
    { "type": "value", "name": "Value", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Considered comfort" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Values" }]
}
{% endschema %}
