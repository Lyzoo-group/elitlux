<section class="pg" style="z-index:{{ section.index }}">
  <div class="nf">
    <p class="ey">{{ section.settings.eyebrow }}</p>
    <h1 class="nf__h">{{ section.settings.heading }}</h1>
    <p class="nf__p">{{ section.settings.text }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="cart__btn">{{ section.settings.button }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Not found",
  "class": "nf-sec",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Not found" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We couldn’t find that page." },
    { "type": "text", "id": "text", "label": "Text", "default": "It may have moved, or the link may be out of date." },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop all" }
  ]
}
{% endschema %}
